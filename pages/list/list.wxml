<!--pages/list/list.wxml 菜谱列表（顶部菜系 tab 支持左右滑动切换）-->
<view class="page-pad" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">

  <!-- 菜系切换（仅中式菜肴）。横滑条及每个标签都带 data-swipe-ignore：
       拖动只滚动标签栏本身，只有点击标签才切换菜系 -->
  <scroll-view wx:if="{{cuisines.length}}" class="cuisine-scroll" scroll-x enable-flex
    data-swipe-ignore="1">
    <text class="cuisine-chip {{!cuisine ? 'chip-active' : ''}}" bindtap="onSelectCuisine"
      data-key="" data-swipe-ignore="1">全部</text>
    <text class="cuisine-chip {{cuisine === item.key ? 'chip-active' : ''}}"
      wx:for="{{cuisines}}" wx:key="key" bindtap="onSelectCuisine"
      data-key="{{item.key}}" data-swipe-ignore="1">{{item.name}}</text>
  </scroll-view>

  <!-- 筛选栏 -->
  <view class="filter-bar">
    <view class="filter-group">
      <text class="filter-label">难度</text>
      <text class="filter-chip {{diffIndex === index ? 'chip-active' : ''}}"
        wx:for="{{difficulties}}" wx:key="*this"
        bindtap="onDiff" data-index="{{index}}">{{item}}</text>
    </view>
    <view class="filter-group">
      <text class="filter-label">排序</text>
      <text class="filter-chip {{sortIndex === index ? 'chip-active' : ''}}"
        wx:for="{{sorts}}" wx:key="key"
        bindtap="onSort" data-index="{{index}}">{{item.name}}</text>
    </view>
  </view>

  <view class="result-count">共 {{total}} 道菜谱</view>

  <!-- 首屏 / 切换筛选条件时的整屏加载态 -->
  <view wx:if="{{loading}}" class="loading-inline">
    <view class="loading-dot"></view>
    <text>加载中…</text>
  </view>

  <!-- 菜谱卡片 -->
  <block wx:else>
    <view class="card list-card" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <image wx:if="{{item.coverImageUrl}}" class="cover list-cover" src="{{item.coverImageUrl}}" mode="aspectFill" lazy-load="{{true}}" />
      <view wx:else class="cover list-cover"></view>
      <view class="col flex-1 list-info">
        <view class="list-title ellipsis">{{item.title}}</view>
        <view class="list-desc ellipsis-2">{{item.desc}}</view>
        <view class="row list-meta">
          <text class="tag tag-hot">{{item.difficulty}}</text>
          <text class="list-meta-text">{{item.time}}分钟</text>
          <text class="list-meta-text">{{item.servings}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{!list.length}}" class="empty">
      <text class="empty-emoji">🥕</text>
      没有符合条件的菜谱，换个筛选试试
    </view>

    <!-- 触底加载下一页 -->
    <view wx:if="{{loadingMore}}" class="loading-inline loading-inline-compact">
      <view class="loading-dot"></view>
      <text>加载中…</text>
    </view>
    <view wx:elif="{{list.length && !hasMore}}" class="loading-inline loading-inline-compact">
      <text>没有更多菜谱啦</text>
    </view>
  </block>

</view>
